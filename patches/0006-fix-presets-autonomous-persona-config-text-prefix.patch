From 27e9e3eb27965b656066daf6463dd310c487f3a8 Mon Sep 17 00:00:00 2001
From: Mlte0907 <Mlte0907@users.noreply.github.com>
Date: Thu, 10 Sep 2026 00:41:48 +0800
Subject: [PATCH 6/6] fix(presets): autonomous persona config text -> prefix

0.1.3-alpha.2 split the dsh-persona config into a required `prefix` and an
optional `suffix`; the old `text` key no longer validates. Official
standard/ptc presets already use prefix/suffix.
---
 .../preset/agent-presets/presets/autonomous/agent.cordis.yml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/packages/preset/agent-presets/presets/autonomous/agent.cordis.yml b/packages/preset/agent-presets/presets/autonomous/agent.cordis.yml
index 9792b8eda8..705856ba33 100644
--- a/packages/preset/agent-presets/presets/autonomous/agent.cordis.yml
+++ b/packages/preset/agent-presets/presets/autonomous/agent.cordis.yml
@@ -55,7 +55,10 @@
 - id: persona
   name: '@deepseek-ai/dsh-persona'
   config:
-    text: >-
+    # 0.1.3-alpha.2 split the persona config into `prefix` (required) and an
+    # optional `suffix`; the old `text` key no longer validates. The working
+    # directory stays in the prefix because this preset ships one prose block.
+    prefix: >-
       You are an autonomous coding agent powered by the {{model}} model, running on the DeepSeek Harness. Your working directory is {{cwd}}.
 
 
-- 
2.43.0

