+# ── Agent Teams (opt-in) ─────────────────────────────────────────────
+#
+# The team tool set (spawn_teammate, send_message, list_agents,
+# team_task_create/list/get/update, wait_agent, interrupt_agent) is
+# registered per-Agent scope by tool-agent-team. Only the Lead may
+# spawn_teammate or interrupt_agent; teammates join via the host
+# agentTeams registry. This row is intentionally not isolated — the
+# tools register into the host agentTeams service, and the persona
+# governs when collaboration is worth the overhead.
+#
+# See the persona above for the collaboration policy and the
+# "before spawning, analyze first" discipline.
+- id: tool-agent-team
+  name: '@deepseek-ai/dsh-tool-agent-team'
+  config:
+    freshProvider: spawn
+    forkProvider: fork
